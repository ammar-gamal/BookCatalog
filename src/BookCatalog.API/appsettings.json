{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      { "Name": "Console" }
    ]

  },
  "ConnectionStrings": {
    "Database": "Server=.; Database=BookCatalog; Integrated Security=SSPI; TrustServerCertificate=True"
  },
  "AllowedHosts": "*"
}
