{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      { "Name": "Console" }
    ]

  },
  "ConnectionStrings": {
    "Database": "Server=.; Database=BookCatalog; Integrated Security=SSPI; TrustServerCertificate=True"
  },
  "Azure": {
    "BlobService": {
      "Endpoint": "https://bookcatalogdev.blob.core.windows.net/",
      "CoverPhoto": {
        "MaxSizeInBytes": 10485760,
        "AllowedExtensions": [ ".jpg", ".png", ".jpeg" ],
        "ContainerName": "bookcovers"
      },
      "BookSample": {
        "MaxSizeInBytes": 104857600,
        "AllowedExtensions": [ ".pdf", ".docx" ],
        "ContainerName": "booksamples"
      }
    }
  },
  "AllowedHosts": "*"
}
